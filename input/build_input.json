{
  "version": "10",
  "configPath": "./build_config.json",
  "tempDir": "temp",
  "domains": {
    "Common": {
      "type": "all",
      "tableDir": "Domains/Common",
      "tableFiles": [
        "CommonTable.xlsx"
      ],
      "stringDir": "Domains/Common",
      "stringFiles": [
        "StringTable.xlsx"
      ]
    },
    "Game": {
      "type": "client",
      "contractDir": "Domains/Game",
      "contractFiles": [
        "*.json"
      ],
      "tableDir": "Domains/Game",
      "tableFiles": [
        "AchieveTable.xlsx",
        "GameConfigTable.xlsx",
        "GameErrorTable.xlsx",
        "GameMessageTable.xlsx",
        "ItemTable.xlsx",
        "MetaTable.xlsx",
        "MissionTable.xlsx",
        "ShopTable.xlsx",
        "SkillTable.xlsx",
        "TreasureTable.xlsx",
        "UnitTable.xlsx"
      ],
      "stringDir": "Domains/Game",
      "stringFiles": [
        "GameStringTable.xlsx"
      ]
    },
    "Sound": {
      "type": "client",
      "tableDir": "Domains/Sound",
      "tableFiles": [
        "*.xlsx"
      ]
    },
    "Operation": {
      "type": "all",
      "tableDir": "Domains/Operation",
      "tableFiles": [
        "OperationTable.xlsx"
      ]
    }
  },
  "protocols": [
    {
      "group": "Game",
      "protocolDir": "./Protocols/Game",
      "protocolFiles": [
        "C2Game.json",
        "Game2C.json"
      ]
    }
  ]
}
